                        "vin",
                        ":vin"
                      ],
                      "query": [
                        {
                          "description": "Includes body, engine, and mileage data (default: no)",
                          "key": "verbose",
                          "value": "no"
                        },
                        {
                          "description": "Includes all trims for the matching model (default: no)",
                          "key": "all_trims",
